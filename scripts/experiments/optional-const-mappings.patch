--- /dev/null
+++ b/whippyalgebra/tests/standalone_indexing.rs
@@ -0,0 +1,25 @@
+//! Backend-free indexing keeps typenum's original types and wider bridge domain.
+#![cfg(all(feature = "standalone-indexing", not(feature = "nalgebra")))]
+
+use whippyalgebra::{DCons, DNil, DimList, ElemAt, Nat, Repeat, ShapeIndex, Unsigned};
+use whippyunits::unit;
+
+trait Same<Rhs> {}
+impl<T> Same<T> for T {}
+fn same<L: Same<R>, R>() {}
+
+#[test]
+fn backend_free_bridge_preserves_typenum_identity_beyond_nalgebra_limit() {
+    same::<Nat<1024>, typenum::U1024>();
+    same::<<typenum::Const<1024> as ShapeIndex>::Nat, typenum::U1024>();
+    assert_eq!(<Nat<1024> as Unsigned>::USIZE, 1024);
+}
+
+#[test]
+fn backend_free_indexing_and_uniform_lists_keep_their_units() {
+    type Units = DCons<unit!(m), DCons<unit!(s), DCons<unit!(kg), DNil>>>;
+    same::<<Units as ElemAt<Nat<1>>>::Elem, unit!(s)>();
+    type ThreeMeters = <Nat<3> as Repeat<unit!(m)>>::Out;
+    assert_eq!(<ThreeMeters as DimList>::LEN, 3);
+    same::<<ThreeMeters as ElemAt<Nat<2>>>::Elem, unit!(m)>();
+}
