+    T: core::ops::Div<Output = T>,
+{
+    type Output = Quantity<crate::unit::DivUnit<U, V>, T, Brand>;
+
+    fn div(self, other: Quantity<V, T, Brand>) -> Self::Output {
+        Quantity::from_raw_value(self.unsafe_value / other.unsafe_value)
+    }
+}
diff --git a/tests/unit_trait_arithmetic.rs b/tests/unit_trait_arithmetic.rs
new file mode 100644
--- /dev/null
+++ b/tests/unit_trait_arithmetic.rs
@@ -0,0 +1,80 @@
+//! The quantity operators delegate units to associated-output traits, while
+//! storage values are moved and need only the operation being performed.
+
+use whippyunits::quantity::Quantity;
+use whippyunits::unit::{DivUnit, MulUnit, UnitDiv, UnitMul};
+use whippyunits::{qty, unit};
+
+// Deliberately not Copy, Clone, NumCast, PartialEq, or Default.
+struct Owned(Box<f64>);
+struct Brand;
+
+impl core::ops::Mul for Owned {
+    type Output = Self;
+    fn mul(self, rhs: Self) -> Self {
+        Self(Box::new(*self.0 * *rhs.0))
+    }
+}
+
+impl core::ops::Div for Owned {
+    type Output = Self;
+    fn div(self, rhs: Self) -> Self {
+        Self(Box::new(*self.0 / *rhs.0))
+    }
+}
+
+fn multiply<U: UnitMul<V>, V, T: core::ops::Mul<Output = T>, B>(
+    lhs: Quantity<U, T, B>,
+    rhs: Quantity<V, T, B>,
+) -> Quantity<MulUnit<U, V>, T, B> {
+    lhs * rhs
+}
+
+fn divide<U: UnitDiv<V>, V, T: core::ops::Div<Output = T>, B>(
+    lhs: Quantity<U, T, B>,
+    rhs: Quantity<V, T, B>,
+) -> Quantity<DivUnit<U, V>, T, B> {
+    lhs / rhs
+}
+
+#[test]
+fn non_copy_storage_and_brand_survive_abstract_unit_operations() {
+    let length: qty!(m, Owned, Brand) = Quantity::new(Owned(Box::new(12.0)));
+    let duration: qty!(tick, Owned, Brand) = Quantity::new(Owned(Box::new(6.0)));
+    let speed: qty!(m / tick, Owned, Brand) = divide(length, duration);
+    assert_eq!(*speed.unsafe_value.0, 2.0);
+
+    let duration: qty!(tick, Owned, Brand) = Quantity::new(Owned(Box::new(3.0)));
+    let length: qty!(m, Owned, Brand) = multiply(speed, duration);
+    assert_eq!(*length.unsafe_value.0, 6.0);
+}
+
+#[test]
+fn scalar_right_keeps_its_unit_with_the_same_non_copy_storage() {
+    let length: qty!(mm, Owned, Brand) = Quantity::new(Owned(Box::new(12.0)));
+    let doubled: qty!(mm, Owned, Brand) = length * Owned(Box::new(2.0));
+    let halved: qty!(mm, Owned, Brand) = doubled / Owned(Box::new(4.0));
+    assert_eq!(*halved.unsafe_value.0, 6.0);
+}
+
+#[test]
+fn primitive_left_keeps_multiplication_and_inverse_division() {
+    let angle: qty!(deg, f64, Brand) = Quantity::new(30.0);
+    let doubled: qty!(deg, f64, Brand) = 2.0 * angle;
+    let reciprocal: qty!(1 / deg, f64, Brand) = 60.0 / doubled;
+    assert_eq!(doubled.unsafe_value, 60.0);
+    assert_eq!(reciprocal.unsafe_value, 1.0);
+}
+
+#[test]
+fn generic_unit_bounds_compose_scales_and_cancel_them() {
+    type Length = unit!(mm);
+    type Duration = unit!(tick);
+    let length = Quantity::<Length>::new(120.0);
+    let duration = Quantity::<Duration>::new(6.0);
+    let speed: qty!(mm / tick) = divide(length, duration);
+    let restored: qty!(mm) = multiply(speed, duration);
+    let speed_si: qty!(m / s) = whippyunits::api::rescale(speed);
+    assert!((speed_si.unsafe_value - 1.2).abs() < 1e-12);
+    assert_eq!(restored.unsafe_value, 120.0);
+}
