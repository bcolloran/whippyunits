+#!/usr/bin/env python3
+"""Generate the bounded exponent backend, or verify it with --check."""
+import argparse
+from pathlib import Path
+
+LIMIT = 32
+
+
+def generated():
+    out = [
+        "// @generated by tools/generate-direct-exponents.py; do not edit by hand.\n",
+        "// Inputs: -32..=32. Add/Sub outputs: -64..=64.\n\n",
+        "use super::{Halve, N, NumEq};\n",
+        "use core::ops::{Add, Neg, Sub};\n\n",
+    ]
+    for left in range(-LIMIT, LIMIT + 1):
+        for right in range(-LIMIT, LIMIT + 1):
+            for trait, method, result in [("Add", "add", left + right), ("Sub", "sub", left - right)]:
+                out.append(f"impl {trait}<N<{right}>> for N<{left}> {{\n    type Output = N<{result}>;\n\n    fn {method}(self, _: N<{right}>) -> Self::Output {{\n        N\n    }}\n}}\n\n")
+            bit = "B1" if left == right else "B0"
+            out.append(f"impl NumEq<N<{right}>> for N<{left}> {{\n    type Output = typenum::{bit};\n}}\n\n")
+        out.append(f"impl Neg for N<{left}> {{\n    type Output = N<{-left}>;\n\n    fn neg(self) -> Self::Output {{\n        N\n    }}\n}}\n\n")
+        if left % 2 == 0:
+            out.append(f"impl Halve for N<{left}> {{\n    type Output = N<{left // 2}>;\n}}\n\n")
+    return "".join(out).rstrip() + "\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    path = Path(__file__).resolve().parents[1] / "whippyunits-core/src/num/direct.rs"
+    content = generated()
+    if args.check:
+        if not path.exists() or path.read_text() != content:
+            parser.exit(1, "Direct exponent table is stale; run tools/generate-direct-exponents.py\n")
+        print("Direct exponent table is up to date.")
+    else:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(content)
+        print("Wrote 12,773 direct exponent implementations.")
+
+
+if __name__ == "__main__":
+    main()
